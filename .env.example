# ==========================================
# NEXAI Warehouse Digital Twin - Environment Configuration
# ==========================================

# Frontend Dev Server Configuration (Vite)
VITE_PORT=5173
VITE_APP_TITLE="NEXAI - 3D Warehouse Digital Twin"
VITE_DATA_FILE_PATH="/orders.json"

# Simulation Physics & Parameter Defaults
VITE_DEFAULT_SIM_SPEED=2
VITE_WALKING_SPEED_MPS=1.2
VITE_ITEM_PICK_TIME_SEC=4.0

# Optional Analytics & Feature Flags
VITE_ENABLE_PERF_MONITOR=false
VITE_DEBUG_GRID_COORDINATES=false

# Data Pipeline Parameters (Python preprocess.py)
DATA_PIPELINE_EXCEL_PATH="data-pipeline/online_retail_II.xlsx"
DATA_PIPELINE_TARGET_YEAR=2009
DATA_PIPELINE_TARGET_MONTH=12
DATA_PIPELINE_TOP_PRODUCTS_COUNT=100
DATA_PIPELINE_OUTPUT_PATH="orders.json"
